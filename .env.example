# ============================================================
# 環境變數範本（不會 commit .env 本身）
# 開發：
#   DATABASE_URL="file:./dev.db"
# Vercel production (M1 之後會切換):
#   DATABASE_URL="postgresql://..."
# ============================================================

# Database （Prisma 連線字串）
DATABASE_URL="file:./dev.db"

# M2 之後需要：
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=rental-aggregator-assets

# M3 之後需要：
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# M2 之後需要：
# CLERK_SECRET_KEY=
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
