# ============================================================
# 環境變數範本（不會 commit .env 本身）
# 開發：
#   DATABASE_URL="file:./dev.db"
# Vercel production (M1 之後會切換):
#   DATABASE_URL="postgresql://..."
# ============================================================

# Database （Prisma 連線字串）
DATABASE_URL="file:./dev.db"

# M2 之後需要：
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=rental-aggregator-assets

# M3 之後需要：
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# M2 之後需要：
# CLERK_SECRET_KEY=
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# M3.5 Rate limit hardening（R2 follow-up，Upstash Redis）
# 沒設 → production 走 in-memory fallback（跟 M3 行為一樣，user Phase 0 未完成時）
# 設了 → 多 Vercel instance 共享計數（解決 M3 known limitation R2）
# 在 https://console.upstash.com/ 建立 Redis database 後複製 REST API 區塊的值
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
