name: CI

on:
  push:
    branches: [main]
  pull_request:
    branches: [main]

# 最小權限：只讀 contents，避免 workflow 有多餘能力。
# 不需要寫 token / 不需要 deploy，因此不給 id-token / packages。
permissions:
  contents: read

# 取消舊 in-flight run，避免同一 PR 多筆 push 浪費 runner。
concurrency:
  group: ci-${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

jobs:
  verify:

